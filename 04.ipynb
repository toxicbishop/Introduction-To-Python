   "source": [
    "str1 = input(\"Enter a multi-digit number: \") \n",
    "d = dict() \n",
    "for c in str1: \n",
    "    if c in d.keys(): \n",
    "        d[c] = d[c] + 1 \n",
    "    else: \n",
    "        d[c] = 1 \n",
    "for k,v in d.items(): \n",
    "    print(\"Number \",k,\" has frequency: \",v) \n"
   ]
  }
